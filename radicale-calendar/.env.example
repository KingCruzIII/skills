RADICALE_URL=https://your-radicale-host.example.com/
RADICALE_USERNAME=your-username
RADICALE_PASSWORD=your-password
# IANA timezone name (e.g. Europe/Amsterdam, America/New_York, Asia/Tokyo) -
# list-events etc. convert start/end to this zone before returning them.
# Leave unset to get times back in UTC (explicit +00:00 offset, never
# silently wrong, just not converted).
RADICALE_TIMEZONE=
